---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Fil from '../components/Fil.astro';
import Hero from '../components/Hero.astro';
import Sequence from '../components/Sequence.astro';
import Shopify from '../components/Shopify.astro';
import Automatisation from '../components/Automatisation.astro';
import Methode from '../components/Methode.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />
  <main id="main" class="page" tabindex="-1">
    <Fil />
    <Hero />
    <Sequence />
    <Shopify />
    <Automatisation />
    <Methode />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Base>
