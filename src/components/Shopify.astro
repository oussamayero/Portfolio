---
// Section Shopify : situations, projets anonymisés réalisés en agence, livrables.
// Les captures se déposent dans src/assets/projets/ et se référencent par leur nom de fichier dans shopify.json.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import shopify from '../content/accueil/shopify.json';
import site from '../content/site.json';
import Atelier from './Atelier.astro';
import { typo } from '../lib/typo';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const capture = (file: string) => {
  if (!file) return undefined;
  const key = Object.keys(images).find((k) => k.endsWith(`/${file}`));
  return key ? images[key].default : undefined;
};

// Seuls les projets dont au moins une capture est fournie sont affichés.
const projets = shopify.projets
  .map((p) => ({ ...p, desktop: capture(p.captureDesktop), mobile: capture(p.captureMobile) }))
  .filter((p) => p.desktop || p.mobile)
  .map((p, n) => ({ ...p, n: n + 1 }));
const total = projets.length;
const enAttente = shopify.projets.length - total;
---

<div class="shopify" id="shopify" role="tabpanel" aria-labelledby="tab-shopify">
  <div class="wrap">
    <div class="main">
      <div class="intro">
        <h2 class="t-h2 title" id="shopify-title">{typo(shopify.titre)}</h2>
        <p class="t-lead">{typo(shopify.texte)}</p>
        <div class="situations">
          <p class="t-label">{typo(shopify.situationsTitre)}</p>
          <ul>
            {
              shopify.situations.map((s) => (
                <li>
                  <a href={site.actionPrincipale.ancre} data-need={`shopify-${s.cle}`}>
                    <span class="s-type">
                      {typo(s.type)}
                      <span class="s-arrow" aria-hidden="true">→</span>
                    </span>
                    <span class="s-text">{typo(s.texte)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="demo">
        <Atelier />
      </div>
    </div>

    <details class="deliverables" open data-deliverables>
      <summary><h3 class="t-label">{typo(shopify.livraisonsTitre)}</h3><span class="count" aria-hidden="true">{shopify.livrables.length}</span></summary>
      <ul>
        {
          shopify.livrables.map((l) => (
            <li>
              {typo(l.texte)}
              {l.aConfirmer && <span class="a-fournir">à confirmer</span>}
            </li>
          ))
        }
      </ul>
    </details>

    {
      total > 0 ? (
        <div class="cases" data-cases>
          <p class="sr-only" aria-live="polite" data-cases-status>Projet 1 sur {total}</p>
          {
            projets.map((p) => (
              <article class="case" data-case hidden={p.n !== 1} aria-label={`Projet ${p.n} sur ${total}`}>
                <div class="shots">
                  <figure class="browser">
                    <div class="bar" aria-hidden="true">
                      <i />
                      <i />
                      <i />
                      <span>Adresse masquée</span>
                    </div>
                    {p.desktop ? (
                      <Image src={p.desktop} alt={typo(p.description || 'Capture desktop du projet')} widths={[640, 960, 1280, 1600]} sizes="(min-width: 900px) 70vw, 100vw" />
                    ) : (
                      <div class="placeholder ratio-d">
                        <span>Capture desktop réelle d’un projet anonymisé · à fournir</span>
                      </div>
                    )}
                  </figure>
                  <figure class="phone">
                    {p.mobile ? (
                      <Image src={p.mobile} alt={typo(p.description || 'Capture mobile du projet')} widths={[360, 540, 720]} sizes="(min-width: 900px) 18vw, 80vw" />
                    ) : (
                      <div class="placeholder ratio-m">
                        <span>Capture mobile · à fournir</span>
                      </div>
                    )}
                  </figure>
                </div>
                <div class="meta">
                  <span class="tag">{typo(p.statut)}</span>
                  <span>Secteur : {p.secteur ? typo(p.secteur) : <span class="a-fournir">à fournir</span>}</span>
                  <span>Contribution : {p.contribution ? typo(p.contribution) : <span class="a-fournir">à fournir</span>}</span>
                </div>
              </article>
            ))
          }
          {
            total > 1 && (
              <div class="nav">
                <button type="button" class="pill" data-cases-prev>
                  ← Précédent
                </button>
                <span class="count" aria-hidden="true" data-cases-count>
                  1 / {total}
                </span>
                <button type="button" class="pill" data-cases-next>
                  Suivant →
                </button>
              </div>
            )
          }
        </div>
      ) : (
        site.chantier && (
          <p class="pending">
            <span class="a-fournir">Projets réalisés en agence · {enAttente} emplacements prêts</span> captures desktop et mobile, secteur et contribution à fournir.
          </p>
        )
      )
    }

    <p class="cta"><a class="tlink" href={site.actionPrincipale.ancre} data-need="shopify">{typo(shopify.lien)}&nbsp;→</a></p>
  </div>
</div>

<style>
  .wrap {
    padding-block: 40px var(--s-section);
  }

  .main {
    display: grid;
    gap: 36px;
  }

  .title {
    font-size: clamp(1.75rem, 1rem + 1.9vw, 2.6rem);
  }

  .intro .t-lead {
    margin-top: 14px;
    max-width: 32em;
  }

  .situations {
    margin-top: 26px;
  }

  .situations > .t-label {
    margin-bottom: 6px;
  }

  .situations li {
    border-top: 1.5px solid var(--trait);
  }

  .situations li:last-child {
    border-bottom: 1.5px solid var(--trait);
  }

  /* Chaque situation mène au formulaire, avec le besoin pré-renseigné. */
  .situations a {
    display: grid;
    gap: 2px;
    padding: 11px 0;
    text-decoration: none;
    background: linear-gradient(var(--corail), var(--corail)) 0 100% / 0% 2px no-repeat;
    transition: background-size var(--d-4) var(--ease);
  }

  .situations a:hover {
    background-size: 100% 2px;
  }

  .s-text {
    font-family: var(--f-disp);
    font-weight: 650;
    font-stretch: 92%;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .s-type {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 650;
    color: var(--pierre);
  }

  .s-arrow {
    font-size: 0.95rem;
    letter-spacing: 0;
    color: var(--encre);
    transition: transform var(--d-3) var(--ease);
  }

  .situations a:hover .s-arrow {
    transform: translateX(4px);
  }

  .demo {
    min-width: 0;
  }

  .deliverables {
    margin-top: 32px;
    border-top: 1.5px solid var(--trait);
    border-bottom: 1.5px solid var(--trait);
  }

  /* Mobile : liste repliée, on l'ouvre si besoin. */
  .deliverables summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    list-style: none;
    cursor: pointer;
  }

  .deliverables summary::-webkit-details-marker {
    display: none;
  }

  .deliverables summary::after {
    content: '+';
    margin-left: auto;
    font-size: 1.3rem;
    line-height: 1;
  }

  .deliverables[open] summary::after {
    content: '−';
  }

  .deliverables summary .count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    border-radius: var(--r-pill);
    background: var(--ivoire-2);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .deliverables ul {
    padding-bottom: 10px;
  }

  .deliverables ul {
    display: grid;
  }

  .deliverables li {
    position: relative;
    padding: 9px 0 9px 24px;
    font-size: 0.95rem;
  }

  .deliverables li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 15px;
    width: 11px;
    height: 11px;
    border: 2.5px solid var(--corail);
    border-radius: 50%;
  }

  .a-fournir {
    padding: 0.15em 0.5em;
    border-radius: 5px;
    background: var(--todo-bg);
    color: var(--todo);
    font-weight: 650;
    font-size: 0.82em;
  }

  .deliverables .a-fournir {
    margin-left: 6px;
    white-space: nowrap;
  }

  .pending {
    margin-top: 24px;
    font-size: 0.88rem;
    color: var(--pierre);
  }

  .pending .a-fournir {
    margin-right: 6px;
  }

  .cta {
    margin-top: 24px;
  }

  /* Projets (affichés dès qu'une capture est fournie) */
  .cases {
    margin-top: 40px;
  }

  .shots {
    display: grid;
    gap: 16px;
  }

  .browser {
    display: none;
    overflow: hidden;
    border: 1.5px solid var(--trait);
    border-radius: 16px;
    background: var(--papier);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 16px;
    border-bottom: 1.5px solid var(--trait);
  }

  .bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--trait);
  }

  .bar span {
    margin-left: 14px;
    padding: 0.25em 1em;
    border-radius: var(--r-pill);
    background: var(--ivoire-2);
    font-size: 0.75rem;
    color: var(--pierre);
  }

  .phone {
    overflow: hidden;
    border: 1.5px solid var(--trait);
    border-radius: 18px;
    background: var(--papier);
  }

  .shots :global(img) {
    width: 100%;
    height: auto;
  }

  .placeholder {
    display: grid;
    place-items: center;
    padding: 16px;
    text-align: center;
    background: repeating-linear-gradient(135deg, var(--ivoire-2) 0 1.5px, var(--papier) 1.5px 12px);
  }

  .placeholder span {
    padding: 0.2em 0.55em;
    border-radius: 5px;
    background: var(--todo-bg);
    color: var(--todo);
    font-weight: 650;
    font-size: 0.85em;
  }

  .ratio-d {
    aspect-ratio: 16 / 9.6;
  }

  .ratio-m {
    aspect-ratio: 4 / 5;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin-top: 16px;
    font-size: 0.95rem;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }

  .count {
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
  }

  @media (min-width: 900px) {
    .wrap {
      padding-block: 56px 72px;
    }

    .main {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .intro {
      grid-column: 1 / span 5;
    }

    .demo {
      grid-column: 6 / span 7;
    }

    .deliverables {
      margin-top: 40px;
      padding-top: 16px;
      border-bottom: 0;
    }

    /* Ordinateur : toujours ouverte, le titre sert d'étiquette. */
    .deliverables summary {
      min-height: 0;
      margin-bottom: 6px;
      pointer-events: none;
    }

    .deliverables summary::after,
    .deliverables summary .count {
      display: none;
    }

    .deliverables ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--col-gap);
      padding: 0;
    }

    .shots {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }

    .browser {
      display: block;
      grid-column: 1 / span 9;
    }

    .phone {
      grid-column: 10 / span 3;
      margin-top: 40px;
      border: 1.5px solid var(--encre);
      border-radius: 30px;
      padding: 8px;
    }

    .phone .placeholder,
    .phone :global(img) {
      border-radius: 22px;
    }

    .ratio-m {
      aspect-ratio: 9 / 18.5;
    }

    .nav {
      justify-content: flex-end;
      margin-top: 12px;
    }

    .cta {
      margin-top: 28px;
    }
  }
</style>

<script>
  import { desktopQuery } from '../scripts/motion';

  // Livrables : ouverts sur ordinateur, repliés sur mobile (ouverts sans JavaScript).
  const deliverables = document.querySelector<HTMLDetailsElement>('[data-deliverables]');
  if (deliverables) {
    const sync = () => (deliverables.open = desktopQuery.matches);
    sync();
    desktopQuery.addEventListener('change', sync);
  }

  const root = document.querySelector<HTMLElement>('[data-cases]');
  if (root) {
    const cases = Array.from(root.querySelectorAll<HTMLElement>('[data-case]'));
    const count = root.querySelector('[data-cases-count]');
    const status = root.querySelector('[data-cases-status]');
    let index = 0;
    const show = (next: number) => {
      index = (next + cases.length) % cases.length;
      cases.forEach((c, i) => (c.hidden = i !== index));
      const text = `${index + 1} / ${cases.length}`;
      if (count) count.textContent = text;
      if (status) status.textContent = `Projet ${index + 1} sur ${cases.length}`;
    };
    root.querySelector('[data-cases-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-cases-next]')?.addEventListener('click', () => show(index + 1));
  }
</script>
