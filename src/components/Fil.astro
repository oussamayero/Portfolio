---
// Couche du fil, placée une seule fois en haut de <main class="page">.
---

<svg class="fil-layer" aria-hidden="true" focusable="false">
  <path class="fil"></path>
  <g class="nodes"></g>
</svg>

<style>
  .fil-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    z-index: 4;
    overflow: visible;
    pointer-events: none;
  }

  .fil {
    fill: none;
    stroke: var(--corail);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fil-layer :global(.nd) {
    stroke: var(--corail);
    fill: var(--ivoire);
    transition: fill 300ms var(--ease);
  }

  .fil-layer :global(.nd.od) {
    fill: var(--nuit);
  }

  .fil-layer :global(.nd.s) {
    fill: var(--sapin);
    stroke: var(--sapin);
  }

  .fil-layer :global(.nd.on) {
    fill: var(--corail);
  }

  .fil-layer :global(.nd-ring) {
    fill: none;
    stroke: var(--corail);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .fil-layer :global(.nd-ring.pulse) {
    animation: nd-pulse 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes nd-pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.8);
    }
  }

  /* Nœuds reliés à une section : raccourci à la souris. */
  .fil-layer :global(.nd-link) {
    pointer-events: auto;
    cursor: pointer;
  }

  .fil-layer :global(.nd-hit) {
    fill: transparent;
  }

  .fil-layer :global(.nd-link .nd) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--d-2) var(--ease), fill 300ms var(--ease);
  }

  .fil-layer :global(.nd-link:hover .nd) {
    transform: scale(1.3);
  }
</style>

<script>
  import { initFil } from '../scripts/fil';

  const page = document.querySelector<HTMLElement>('main.page');
  if (page) initFil(page);
</script>
