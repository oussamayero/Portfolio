          </g>
          <g class="s-thumbs" clip-path="url(#clip-thumbs-m)">
            <image href={S.trench} x="40" y="314" width="56" height="56" preserveAspectRatio="xMidYMid slice"></image>
            <image href={S.archi} x="104" y="314" width="56" height="56" preserveAspectRatio="xMidYMid slice"></image>
            <image href={S.nuit} x="168" y="314" width="56" height="56" preserveAspectRatio="xMidYMid slice"></image>
            <image href={S.duo} x="232" y="314" width="56" height="56" preserveAspectRatio="xMidYMid slice"></image>
          </g>
          <g class="s-info">
            <text class="k-t k-mut" x="206" y="110" font-size="9" letter-spacing="1.6" font-weight="650">MANTEAU LONG</text>
            <text class="k-d" x="206" y="138" font-size="24">Trench Ligne</text>
            <text class="k-t k-mut" x="206" y="156" font-size="9.5">Coton ciré · sable</text>
            <text class="k-t" x="206" y="184" font-size="15" font-weight="650">320,00 €</text>
            <g>
              <rect class="k-pap k-strk" x="206" y="198" width="34" height="26" rx="13"></rect><text class="k-t" x="223" y="215" font-size="10" text-anchor="middle">XS</text>
              <rect class="k-pap k-strk" x="244" y="198" width="34" height="26" rx="13"></rect><text class="k-t" x="261" y="215" font-size="10" text-anchor="middle">S</text>
              <rect class="k-enc" x="282" y="198" width="34" height="26" rx="13"></rect><text class="k-t k-ivt" x="299" y="215" font-size="10" font-weight="650" text-anchor="middle">M</text>
              <rect class="k-pap k-strk" x="320" y="198" width="34" height="26" rx="13"></rect><text class="k-t" x="337" y="215" font-size="10" text-anchor="middle">L</text>
            </g>
            <g><rect class="k-enc" x="206" y="238" width="154" height="34" rx="17"></rect><text class="k-t k-ivt" x="283" y="259" font-size="10.5" font-weight="650" text-anchor="middle">Ajouter au panier</text></g>
            <text class="k-t k-mut" x="40" y="404" font-size="10">Coupe ample, longueur mi-mollet</text>
          </g>
          <path class="s-cardline k-fil" pathLength="1" d="M20 250 V44 Q20 30 34 30 H366 Q380 30 380 44 V456 Q380 470 366 470 H34 Q20 470 20 456 Z"></path>
          <path class="s-imgline k-out" pathLength="1" d="M40 92 H190 V298 H40 Z"></path>
