          <clipPath id="clip-thumbs-m">
            <rect x="40" y="314" width="56" height="56" rx="7"></rect><rect x="104" y="314" width="56" height="56" rx="7"></rect>
            <rect x="168" y="314" width="56" height="56" rx="7"></rect><rect x="232" y="314" width="56" height="56" rx="7"></rect>
          </clipPath>
          <clipPath id="clip-lift-m"><rect class="s-liftclip" x="40" y="92" width="150" height="206" rx="8"></rect></clipPath>
          <clipPath id="clip-ad-m"><rect x="88" y="30" width="224" height="398" rx="14"></rect></clipPath>
