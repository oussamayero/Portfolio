    <p class="credit">Photos de démonstration · marque fictive, aucun client réel.</p>
    <Wp i={29} only="d" style="left:calc(100% - var(--pr) / 2);bottom:56px" />
    <Wp i={30} only="d" style="left:calc(var(--pl) + var(--gut));bottom:56px" />
  </div>
</section>

<style>
  .wrap {
    padding-top: 28px;
    padding-bottom: 80px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 24px;
    margin-bottom: 24px;
  }

  .heading {
    position: relative;
  }

  .title {
    margin-top: 14px;
    font-family: var(--f-disp);
    font-weight: 740;
    font-stretch: 90%;
    font-size: clamp(1.4rem, 1rem + 1vw, 1.9rem);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: var(--ivoire-2);
  }

  .sv {
    width: 100%;
    height: auto;
  }

  .sv-d {
    display: none;
  }

  /* Avant le chargement de l'animation : la fiche produit seule, comme affiche. */
  .sv :global(:is(.s-ad, .s-order, .s-lift, .s-conn, .s-arc, .s-filout, .s-br, .s-nd, .s-lb, .s-tap, .s-cardline, .s-imgline, .s-tline, .s-cursor)) {
    opacity: 0;
  }

  .stage :global(.k-iv2) { fill: var(--ivoire-2); }
  .stage :global(.k-pap) { fill: var(--papier); }
  .stage :global(.k-enc) { fill: var(--encre); }
  .stage :global(.k-cor) { fill: var(--corail); }
  .stage :global(.k-sap) { fill: var(--sapin); }
  .stage :global(.k-strk) { stroke: var(--trait); stroke-width: 2; }
  .stage :global(.k-hair) { stroke: var(--trait); stroke-width: 2; }
  .stage :global(.k-t) { font-family: var(--f-body); fill: var(--encre); }
  .stage :global(.k-d) { font-family: var(--f-disp); font-weight: 790; font-stretch: 88%; letter-spacing: -0.03em; fill: var(--encre); }
  .stage :global(.k-mut) { fill: var(--pierre); }
  .stage :global(.k-ivt) { fill: var(--ivoire); }
  .stage :global(.k-fil) { fill: none; stroke: var(--corail); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .stage :global(.k-out) { fill: none; stroke: var(--encre); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .stage :global(.k-dash) { fill: none; stroke: var(--corail); stroke-width: 2; stroke-dasharray: 6 6; stroke-linecap: round; }
  .stage :global(.k-sapl) { fill: none; stroke: var(--sapin); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .stage :global(.s-tap) { fill: none; stroke: var(--corail); stroke-width: 3; }
  .stage :global(.s-cursor-ring) { fill: rgb(255 252 248 / 0.55); stroke: var(--encre); stroke-width: 1.5; }

  .chapters {
    position: relative;
    margin-top: 24px;
  }

  li {
    position: relative;
    border-top: 1.5px solid var(--trait);
  }

  li:last-child {
    border-bottom: 1.5px solid var(--trait);
  }

  button {
    all: unset;
    box-sizing: border-box;
    display: grid;
