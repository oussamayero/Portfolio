        </g>

        <path class="s-arc k-dash" d="M462 190 C600 60 720 40 812 90"></path>

        <g class="s-lift" clip-path="url(#clip-lift-d)">
          <image class="s-liftimg s-lifta" href={S.trio} x="172" y="160" width="290" height="400" preserveAspectRatio="xMidYMid slice"></image>
