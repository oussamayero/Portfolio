---
// Séquence signature : une marque fictive (Ostral) traverse les trois métiers en une seule scène.
import { getImage } from 'astro:assets';
import sequence from '../content/accueil/sequence.json';
import Wp from './Wp.astro';
import { typo } from '../lib/typo';
import trio from '../assets/demo/ostral-trio-falaise.jpg';
import trench from '../assets/demo/ostral-trench-ciel.jpg';
import archi from '../assets/demo/ostral-architecture.jpg';
import nuit from '../assets/demo/ostral-manteau-nuit.jpg';
import duo from '../assets/demo/ostral-duo.jpg';

const opt = (src: ImageMetadata) => getImage({ src, width: 720, format: 'webp', quality: 74 });
const [imTrio, imTrench, imArchi, imNuit, imDuo] = await Promise.all([trio, trench, archi, nuit, duo].map(opt));
const S = { trio: imTrio.src, trench: imTrench.src, archi: imArchi.src, nuit: imNuit.src, duo: imDuo.src };
---

<section class="seq" id="demonstrations" aria-labelledby="seq-title" data-sequence>
  <div class="wrap">
    <div class="top">
      <div class="heading">
        <Wp i={20} node="o" href="#demonstrations" style="left:var(--gut);top:16px" />
        <span class="tag">{typo(sequence.statut)}</span>
        <h2 class="title" id="seq-title">{typo(sequence.titre)}</h2>
      </div>
      <div class="controls">
        <button type="button" class="pill" data-seq-play data-play="Lecture" data-pause="Pause" data-reduced="Lire l’animation">Lecture</button>
        <button type="button" class="pill" data-seq-replay>Rejouer</button>
      </div>
    </div>

    <div class="stage" data-stage>
      <!-- Desktop, 16:9 -->
      <svg class="sv sv-d" viewBox="0 0 1280 720" role="img" aria-labelledby="sv-d-title">
        <title id="sv-d-title">{typo(sequence.description)}</title>
        <defs>
          <clipPath id="clip-img-d"><rect x="172" y="160" width="290" height="400" rx="12"></rect></clipPath>
          <clipPath id="clip-thumbs-d">
            <rect x="172" y="574" width="62" height="62" rx="8"></rect><rect x="246" y="574" width="62" height="62" rx="8"></rect>
            <rect x="320" y="574" width="62" height="62" rx="8"></rect><rect x="394" y="574" width="62" height="62" rx="8"></rect>
          </clipPath>
          <clipPath id="clip-lift-d"><rect class="s-liftclip" x="172" y="160" width="290" height="400" rx="12"></rect></clipPath>
          <clipPath id="clip-ad-d"><rect x="812" y="40" width="360" height="640" rx="20"></rect></clipPath>
          <clipPath id="clip-order-d"><rect x="174" y="282" width="66" height="88" rx="8"></rect></clipPath>
          <linearGradient id="grad-ad-d" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0.4" stop-color="#16110e" stop-opacity="0"></stop>
            <stop offset="1" stop-color="#16110e" stop-opacity="0.82"></stop>
          </linearGradient>
        </defs>
        <rect class="k-iv2" width="1280" height="720"></rect>
        <path class="s-filin k-fil" pathLength="1" d="M-10 360 H140"></path>

        <g class="s-page">
          <rect class="s-card k-pap k-strk" x="140" y="70" width="640" height="580" rx="18"></rect>
          <g class="s-head">
            <text class="k-t" x="172" y="116" font-size="18" font-weight="700" letter-spacing="6">OSTRAL</text>
            <text class="k-t k-mut" x="748" y="116" font-size="15" text-anchor="end">Manteaux    Vestes    Journal</text>
            <line class="k-hair" x1="140" y1="138" x2="780" y2="138"></line>
          </g>
          <g class="s-img" clip-path="url(#clip-img-d)">
            <image class="s-imgph" href={S.trio} x="172" y="160" width="290" height="400" preserveAspectRatio="xMidYMid slice"></image>
          </g>
