          <image class="s-liftimg s-lifta" href={S.trio} x="40" y="92" width="150" height="206" preserveAspectRatio="xMidYMid slice"></image>
          <image class="s-liftimg s-liftb" href={S.trench} x="40" y="92" width="150" height="206" preserveAspectRatio="xMidYMid slice"></image>
        </g>

        <g class="s-ad">
          <g clip-path="url(#clip-ad-m)">
            <image class="s-adimg" href={S.trench} x="88" y="30" width="224" height="398" preserveAspectRatio="xMidYMid slice"></image>
            <rect x="88" y="30" width="224" height="398" fill="url(#grad-ad-m)"></rect>
          </g>
          <text class="s-adlabel k-t k-ivt" x="104" y="56" font-size="8.5" font-weight="700" letter-spacing="2.2">OSTRAL · AUTOMNE</text>
          <text class="s-adfmt k-t k-ivt" x="296" y="56" font-size="8.5" font-weight="650" text-anchor="end" opacity="0.8">9:16</text>
          <text class="s-adw k-d k-ivt" x="103" y="336" font-size="32">Le trench,</text>
          <text class="s-adw k-d k-ivt" x="103" y="368" font-size="32">repensé.</text>
          <g class="s-adbtn"><rect class="k-cor" x="104" y="382" width="96" height="30" rx="15"></rect><text class="k-t" x="152" y="401" font-size="11" font-weight="650" text-anchor="middle">Découvrir</text></g>
