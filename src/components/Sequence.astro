          <text class="k-t k-mut" x="262" y="300" font-size="13" font-weight="650" letter-spacing="2.5">NOUVELLE COMMANDE</text>
          <text class="k-d" x="262" y="354" font-size="46">n° 1042</text>
          <text class="k-t k-mut" x="262" y="392" font-size="17">Trench Ligne · sable · M</text>
          <text class="k-t" x="174" y="440" font-size="17" font-weight="650">320,00 €</text>
        </g>

        <path class="s-filout k-fil" pathLength="1" d="M550 360 H650"></path>
        <path class="s-br k-sapl" pathLength="1" d="M650 360 C762 360 786 180 900 180"></path>
        <path class="s-br k-sapl" pathLength="1" d="M650 360 H900"></path>
        <path class="s-br k-sapl" pathLength="1" d="M650 360 C762 360 786 540 900 540"></path>
        <circle class="s-nd k-sap" cx="916" cy="180" r="16"></circle>
        <circle class="s-nd k-sap" cx="916" cy="360" r="16"></circle>
        <circle class="s-nd k-sap" cx="916" cy="540" r="16"></circle>
        <text class="s-lb k-t" x="952" y="189" font-size="27" font-weight="600">Suivi mis à jour</text>
        <text class="s-lb k-t" x="952" y="369" font-size="27" font-weight="600">Fournisseur prévenu</text>
        <text class="s-lb k-t" x="952" y="549" font-size="27" font-weight="600">Équipe prévenue</text>

        <g class="s-cursor"><circle cx="0" cy="0" r="22" class="s-cursor-ring"></circle><circle cx="0" cy="0" r="8" class="k-enc"></circle></g>
