---
// Marque fictive ILVANE (soins, « Huile n°3 ») : symboles SVG partagés par les démonstrations motion.
// À placer une seule fois dans la page ; s'utilisent avec <use href="#ilv-…" />.
// Les couleurs suivent `currentColor` (monogramme, logo) ou les jetons du site (flacon).
---

<svg class="ilv-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <!-- Monogramme : un arc posé sur une barre. -->
    <symbol id="ilv-mono" viewBox="0 0 40 40">
      <path d="M8 19 C12 7 28 7 32 19" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"></path>
      <rect x="17.5" y="17" width="5" height="19" rx="2" fill="currentColor"></rect>
    </symbol>

    <!-- Logo : monogramme et nom, alignés sur le pied de la barre. -->
    <symbol id="ilv-logo" viewBox="8 0 232 60">
      <path d="M12 28.5 C18 10.5 42 10.5 48 28.5" fill="none" stroke="currentColor" stroke-width="6.75" stroke-linecap="round"></path>
      <rect x="26.25" y="25.5" width="7.5" height="28.5" rx="3" fill="currentColor"></rect>
      <text x="70" y="54" fill="currentColor" style="font-family:var(--f-body);font-weight:700;font-size:37px;letter-spacing:0.2em">ILVANE</text>
    </symbol>

    <!-- Flacon « Huile n°3 », 30 ml : pipette encre, verre sapin, étiquette ivoire. Aplats, sans dégradé. -->
    <symbol id="ilv-flacon" viewBox="0 0 320 840">
      <path d="M112 112 V62 A48 48 0 0 1 208 62 V112 Z" style="fill:var(--encre)"></path>
      <rect x="86" y="104" width="148" height="100" rx="12" style="fill:var(--encre)"></rect>
      <rect x="86" y="182" width="148" height="9" style="fill:var(--corail)"></rect>
      <path d="M100 126 H220 M100 142 H220 M100 158 H220" style="fill:none;stroke:var(--nuit-2);stroke-width:4"></path>
      <rect x="118" y="200" width="84" height="40" style="fill:var(--sapin)"></rect>
      <path
        d="M118 232 C118 262 102 276 62 292 C36 302 24 320 24 346 V794 C24 820 42 836 68 836 H252 C278 836 296 820 296 794 V346 C296 320 284 302 258 292 C218 276 202 262 202 232 Z"
        style="fill:var(--sapin)"></path>
      <rect x="44" y="356" width="18" height="430" rx="9" style="fill:var(--menthe);opacity:0.3"></rect>
      <rect x="62" y="420" width="196" height="300" rx="10" style="fill:var(--ivoire)"></rect>
      <text x="163.3" y="474" text-anchor="middle" style="fill:var(--encre);font-family:var(--f-body);font-weight:700;font-size:22px;letter-spacing:0.3em">ILVANE</text>
      <path d="M136 496 H184" style="stroke:var(--corail);stroke-width:4;stroke-linecap:round"></path>
      <text x="160" y="572" text-anchor="middle" style="fill:var(--encre);font-family:var(--f-disp);font-weight:800;font-stretch:85%;font-size:60px;letter-spacing:-0.03em">Huile</text>
      <text x="160" y="636" text-anchor="middle" style="fill:var(--encre);font-family:var(--f-disp);font-weight:800;font-stretch:85%;font-size:60px;letter-spacing:-0.03em">n°3</text>
      <text x="160" y="690" text-anchor="middle" style="fill:var(--pierre);font-family:var(--f-body);font-weight:600;font-size:22px;letter-spacing:0.08em">30 ml</text>
    </symbol>
  </defs>
</svg>

<style>
  .ilv-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
