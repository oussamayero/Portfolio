---
import hero from '../content/accueil/hero.json';
import site from '../content/site.json';
import Wp from './Wp.astro';
import { typo } from '../lib/typo';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <Wp i={10} only="m" style="left:calc(var(--pl) + var(--gut));top:30px" />
    <div class="top">
      <h1 class="t-hero" id="hero-title">
        {hero.titre.map((ligne, n) => <><span class="line"><span style={`--n:${n}`}>{typo(ligne)}</span></span>{n < hero.titre.length - 1 ? ' ' : ''}</>)}
      </h1>
      <div class="knot-d" aria-hidden="true"><div class="knot" data-3d="knot"></div></div>
    </div>

    <div class="rail" aria-hidden="true">
      <Wp i={10} only="d" style="left:calc(-1 * var(--pl) - 12px);top:0" />
      <Wp i={12} only="d" style="left:41%;top:0" />
    </div>

    <div class="grid">
      <div class="intro">
        <p class="t-lead">{typo(hero.chapeau)}</p>
        <div class="ctas">
          <a class="btn" href={site.actionPrincipale.ancre}>{typo(site.actionPrincipale.libelle)}</a>
          <a class="tlink" href={hero.lienSecondaire.ancre}>{typo(hero.lienSecondaire.libelle)}&nbsp;↓</a>
        </div>
      </div>
      <ol class="index" aria-label="Expertises">
        {
          hero.expertises.map((item, n) => (
            <li style={`--n:${n}`}>
              <Wp i={14 + n} node="o" href={item.ancre} />
              <span class="num" aria-hidden="true">{item.numero}</span>
              <a href={item.ancre}>{typo(item.titre)}</a>
              <span class="detail">{typo(item.detail)}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="knot-m" aria-hidden="true"><div class="knot" data-3d="knot"></div></div>

    <div class="end" aria-hidden="true">
      <Wp i={18} only="d" route="vh" style="left:var(--gut);top:0" />
    </div>
  </div>
</section>

<style>
  .wrap {
    padding-top: 28px;
  }

  .rail {
    position: relative;
    height: 0;
  }

  /* Le fil en volume (three.js) : à droite du titre sur ordinateur, en bande sous l'index sur mobile. */
  .knot-d {
    display: none;
  }

  .knot-m {
    height: 150px;
    margin-top: 12px;
  }

  .knot {
    width: 100%;
    height: 100%;
  }

  .grid {
    display: grid;
    gap: 36px;
    margin-top: 20px;
  }

  .intro .t-lead {
    max-width: 30em;
  }

  .ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px 24px;
    margin-top: 28px;
  }

  .ctas .tlink {
    align-self: flex-start;
  }

  .index li {
    position: relative;
    display: grid;
    padding: 14px 0;
    border-top: 1.5px solid var(--trait);
  }

  .index li:last-child {
    border-bottom: 1.5px solid var(--trait);
  }

  .num {
    display: none;
  }

  .index a {
    font-family: var(--f-disp);
    font-weight: 720;
    font-stretch: 90%;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .index a {
    justify-self: start;
    background: linear-gradient(var(--corail), var(--corail)) 0 100% / 0% 2px no-repeat;
    transition: background-size var(--d-4) var(--ease);
  }

  .index a:hover {
    background-size: 100% 2px;
  }

  .detail {
    font-size: 0.875rem;
    color: var(--pierre);
  }

  .index :global(.wp) {
    left: var(--gut);
    top: 50%;
  }

  .end {
    position: relative;
    height: 0;
    margin-top: 56px;
  }

  /* Entrée : le titre monte, puis le chapeau et l'index se posent pendant que le fil démarre. */
  @media (prefers-reduced-motion: no-preference) {
    h1 {
      animation: h-in 800ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .intro > *,
    .index li > :not(.wp) {
      animation: h-in 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .intro > :first-child {
      animation-delay: 300ms;
    }

    .intro > :nth-child(2) {
      animation-delay: 380ms;
    }

    .index li > :not(.wp) {
      animation-delay: calc(420ms + var(--n) * 80ms);
    }
  }

  @keyframes h-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes h-rise {
    from {
      transform: translateY(108%);
    }
  }

  @media (min-width: 900px) {
    .wrap {
      padding-top: 44px;
    }

    .top {
      display: grid;
      grid-template-columns: max-content minmax(0, 1fr);
      column-gap: 16px;
    }

    h1 span {
      display: block;
      white-space: nowrap;
    }

    .knot-d {
      display: block;
      container-type: inline-size;
      margin: -40px calc(-1 * var(--pr) + 8px) -110px 0;
    }

    /* Trop étroit à côté du titre : pas de fil en volume. */
    @container (max-width: 230px) {
      .knot {
        display: none;
      }
    }

    .knot-m {
      display: none;
    }

    /* Chaque ligne du titre est un masque : le texte monte depuis sa ligne de base. */
    .line {
      overflow: hidden;
      padding-block: 0.06em 0.12em;
      margin-block: -0.06em -0.12em;
    }

    .rail {
      margin-top: 44px;
    }

    .grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      margin-top: 46px;
    }

    .intro {
      grid-column: 1 / span 5;
    }

    .index {
      grid-column: 8 / span 5;
    }

    .ctas {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .ctas .tlink {
      align-self: center;
    }

    .index li {
      grid-template-columns: 34px minmax(0, 1fr);
      padding: 10px 0 14px;
      border: 0;
    }

    .index li:last-child {
      border: 0;
    }

    .num {
      display: block;
      grid-row: span 2;
      padding-top: 6px;
      font-size: 0.75rem;
      color: var(--pierre);
      font-variant-numeric: tabular-nums;
    }

    .index :global(.wp) {
      left: -30px;
      top: 23px;
    }

    .end {
      margin-top: 72px;
    }
  }

  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    h1 {
      animation: none;
    }

    .line > span {
      animation: h-rise 1000ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(60ms + var(--n) * 90ms);
    }
  }
</style>
