---
// Méthode et formules : six étapes posées sur le fil, deux façons de travailler, l'appel à l'action.
import methode from '../content/accueil/methode.json';
import site from '../content/site.json';
import Wp from './Wp.astro';
import { typo } from '../lib/typo';
---

<section class="methode" id="methode" aria-labelledby="methode-title">
  <div class="wrap">
    <p class="t-label eyebrow"><Wp i={60} node="o" href="#methode" style="left:var(--gut);top:50%" />{typo(methode.surtitre)}</p>

    <div class="intro">
      <h2 class="t-h2 title" id="methode-title">{typo(methode.titre)}</h2>
      <p class="t-lead">{typo(methode.texte)}</p>
    </div>

    <div class="steps-wrap">
    <ol class="steps">
      {
        methode.etapes.map((e, n) => (
          <li>
            <Wp i={62 + n} node="o" only="d" route={n === 0 ? 'vh' : undefined} />
            <span class="n" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="t-h3">{typo(e.titre)}</h3>
            <p>{typo(e.texte)}</p>
          </li>
        ))
      }
    </ol>
    <Wp i={68} only="d" style="left:calc(100% + var(--pr) / 2);top:0" />
    </div>

    <div class="bottom">
    <div class="ways">
    <h3 class="t-label formules-title">{typo(methode.formulesTitre)}</h3>
    <div class="formules">
      {
        methode.formules.map((f) => (
          <article class="formule">
            <h4>{typo(f.titre)}</h4>
            <p class="accroche">{typo(f.accroche)}</p>
            <p>{typo(f.texte)}</p>
          </article>
        ))
      }
    </div>

    </div>

    <div class="close">
      <p>{typo(methode.votreCote)} <strong>{typo(methode.tarifs)}</strong></p>
      <a class="btn" href={site.actionPrincipale.ancre}>{typo(site.actionPrincipale.libelle)}</a>
    </div>
    </div>
    <Wp i={69} only="d" style="left:calc(100% - var(--pr) / 2);bottom:40px" />
    <Wp i={69.5} only="d" style="left:calc(var(--pl) + var(--gut));bottom:40px" />
  </div>
</section>

<style>
  .wrap {
    padding-block: var(--s-section);
  }

  .eyebrow {
    position: relative;
    margin-bottom: 24px;
  }

  .title {
    font-size: clamp(1.75rem, 1rem + 1.9vw, 2.6rem);
  }

  .intro {
    display: grid;
    gap: 14px;
  }

  .intro .t-lead {
    max-width: 30em;
  }

  .steps-wrap {
    position: relative;
    margin-top: 28px;
  }

  /* Mobile : deux étapes par ligne. */
  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
  }

  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 4px;
    padding-top: 12px;
    border-top: 1.5px solid var(--trait);
  }

  .steps li :global(.wp) {
    left: 0;
    top: 0;
  }

  .steps .t-h3 {
    font-size: 1.15rem;
  }

  .n {
    font-size: 0.78rem;
    color: var(--pierre);
    font-variant-numeric: tabular-nums;
  }

  .steps p {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--pierre);
  }

  .formules-title {
    margin-top: 36px;
  }

  .formules {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }

  .formule {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 18px;
    border: 1.5px solid var(--trait);
    border-radius: var(--r-l);
    background: var(--papier);
  }

  .formule h4 {
    margin: 0;
    font-family: var(--f-disp);
    font-weight: 760;
    font-stretch: 88%;
    font-size: 1.35rem;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .accroche {
    font-weight: 650;
  }

  .close {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }

  .close p {
    max-width: 40em;
    color: var(--pierre);
  }

  .close strong {
    color: var(--encre);
    font-weight: 650;
  }

  .close .btn {
    justify-self: start;
  }

  @media (min-width: 900px) {
    .wrap {
      padding-bottom: 104px;
    }

    .intro {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: end;
    }

    .intro h2 {
      grid-column: 1 / span 6;
    }

    .intro .t-lead {
      grid-column: 8 / span 5;
    }

    /* Les six étapes sur une ligne : le fil passe par chaque nœud. */
    .steps-wrap {
      margin-top: 48px;
    }

    .steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }

    .steps li {
      padding: 30px 0 0;
      border: 0;
    }

    /* Formules et appel à l'action sur une seule rangée. */
    .bottom {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: end;
      margin-top: 48px;
    }

    .ways {
      grid-column: 1 / span 8;
    }

    .formules-title {
      margin-top: 0;
    }

    .formules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--col-gap);
    }

    .formule {
      padding: 24px 28px;
    }

    .close {
      grid-column: 9 / span 4;
      gap: 18px;
      margin-top: 0;
      padding-bottom: 4px;
    }

    .close p {
      font-size: 0.95rem;
    }
  }
</style>
